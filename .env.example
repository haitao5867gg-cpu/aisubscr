DATABASE_URL="file:./dev.db"
# At least 32 characters. Production refuses this placeholder and the built-in dev fallback.
SESSION_SECRET="change-me-to-a-long-random-string"

# Password-reset mail.
# console — log the message on the server. Real email is NOT sent.
# smtp    — send with nodemailer (Cloudflare Email Sending, Resend, Gmail, …).
#           If SMTP send or SMTP config fails, the error is logged and the
#           console provider is NOT used as a fallback.
# Unset   — smtp when SMTP_HOST is non-empty, otherwise console.
MAIL_PROVIDER="console"

# Visible From address. Required for MAIL_PROVIDER=smtp.
# Example after Cloudflare Email Sending onboarding: noreply@aisubscr.com
MAIL_FROM="noreply@example.com"

# SMTP. Leave SMTP_HOST empty to keep the console provider.
# SMTP_SECURE=true is implicit TLS (port 465). false/empty uses STARTTLS when the server offers it.
# Port 465 defaults to secure=true when SMTP_SECURE is unset.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# Cloudflare Email Sending (do not commit the token):
# MAIL_PROVIDER="smtp"
# MAIL_FROM="noreply@aisubscr.com"
# SMTP_HOST="smtp.mx.cloudflare.net"
# SMTP_PORT="465"
# SMTP_SECURE="true"
# SMTP_USER="api_token"
# SMTP_PASS="<Email Sending: Edit API token>"

# Resend SMTP:
# SMTP_HOST="smtp.resend.com"
# SMTP_PORT="465"
# SMTP_SECURE="true"
# SMTP_USER="resend"
# SMTP_PASS="<Resend API key>"

# Gmail:
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_SECURE="true"
# SMTP_USER="you@gmail.com"
# SMTP_PASS="<Google app password>"

# Public origin for canonical URLs, sitemap, and payment return/notify URLs.
NEXT_PUBLIC_SITE_URL="https://aisubscr.com"

# Optional identity for GET /api/health. The response is only ok, db, version, and commit.
# APP_VERSION overrides package.json. GIT_COMMIT is included only when it is 7–40 hex characters.
# APP_VERSION="0.1.0"
# GIT_COMMIT=""

# Payment. mock is the default and the only provider that completes checkout.
# Do not put live merchant secrets in git. Leave the placeholders empty.
PAYMENT_PROVIDER="mock"
# HMAC-SHA256 hex secret for POST /api/payments/notify/mock (header x-payment-signature).
PAYMENT_WEBHOOK_SECRET=""

# Future WeChat Pay adapter. All of these must be set before PAYMENT_PROVIDER=wechat is selected.
# The skeleton still refuses to create a live charge until that adapter is implemented.
WECHAT_PAY_APP_ID=""
WECHAT_PAY_MCH_ID=""
WECHAT_PAY_API_V3_KEY=""
WECHAT_PAY_MCH_SERIAL=""
WECHAT_PAY_PRIVATE_KEY=""
WECHAT_PAY_NOTIFY_URL=""

# Future Alipay adapter. Same rule: empty means not configured.
ALIPAY_APP_ID=""
ALIPAY_PRIVATE_KEY=""
ALIPAY_PUBLIC_KEY=""
ALIPAY_NOTIFY_URL=""

# Unpaid orders expire after this many minutes and release stock.
# When set (1–1440), this overrides the value in admin site settings. Default 30.
# ORDER_EXPIRE_MINUTES="30"

# Shared secret for POST /api/internal/expire-orders. At least 16 characters.
# Leave empty to hide that route. See deploy/CRON.md.
# nginx denies /api/internal/ except from localhost. See deploy/nginx-https.conf.
# CRON_SECRET=""

# Product images and the customer-service QR. See deploy/UPLOADS.md and docs/DEPLOY.md.
# Local files go to UPLOADS_DIR (default public/uploads) and are served from /uploads/.
# In production that default is the symlink to the shared directory. Optional absolute path:
# UPLOADS_DIR=/opt/aisubscr-shared/uploads
# When any R2 variable below is empty, uploads stay on local disk.
# R2_PUBLIC_BASE_URL must be https in production. Rebuild after changing it so CSP img-src
# includes that origin (the middleware reads the variable when the bundle is built).
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_PUBLIC_BUCKET=""
# R2_PUBLIC_BASE_URL="https://cdn.example.com"
