generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  name           String?
  role           String   @default("USER") // USER | ADMIN
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  sessionVersion Int      @default(0) // bumped on password reset to invalidate iron-session cookies
  orders         Order[]
  tickets        Ticket[]
  ticketReplies  TicketReply[]
  passwordResetCode PasswordResetCode?
}

/// One active password-reset code per user. The code is stored hashed.
model PasswordResetCode {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
}

/// Recent reset-code sends, keyed by email or IP, for rate limits.
model PasswordResetSend {
  id        String   @id @default(cuid())
  bucket    String
  createdAt DateTime @default(now())

  @@index([bucket, createdAt])
}

model Product {
  id              String   @id @default(cuid())
  name            String
  description     String
  priceCents      Int      // RMB fen (分), display as ¥
  imageUrl        String?
  isSubscription  Boolean  @default(false)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  orderItems      OrderItem[]
}

model Order {
  id              String   @id @default(cuid())
  orderNo         String   @unique
  publicToken     String   @unique @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  status          String   @default("PENDING") // PENDING | PAID | COMPLETED | REFUNDED
  totalCents      Int
  paymentMethod   String?  // WECHAT | ALIPAY | MOCK
  paymentProvider String?
  paidAt          DateTime?
  isRenewal       Boolean  @default(false)
  parentOrderId   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  items           OrderItem[]
  tickets         Ticket[]
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  order            Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product @relation(fields: [productId], references: [id])
  productName      String
  unitPriceCents   Int
  quantity         Int     @default(1)
  isSubscription   Boolean @default(false)
}

model Ticket {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  subject   String
  status    String   @default("OPEN") // OPEN | REPLIED | CLOSED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  replies   TicketReply[]
}

model TicketReply {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  body      String
  isStaff   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SiteSetting {
  id           String   @id @default("default")
  siteName     String   @default("aisubscr")
  supportEmail String   @default("support@example.com")
  supportHours String   @default("08:00–23:00")
  footerText   String   @default("示例数字商品商城框架 · 仅供演示")
  updatedAt    DateTime @updatedAt
}

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String
  content     String
  published   Boolean  @default(true)
  authorName  String   @default("管理员")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
