generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  name           String?
  role           String   @default("USER") // USER | ADMIN
  disabled       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  sessionVersion Int      @default(0) // bumped to invalidate iron-session cookies
  orders         Order[]
  tickets        Ticket[]
  ticketReplies  TicketReply[]
  passwordResetCode PasswordResetCode?
  emailChangeCode EmailChangeCode?
  auditLogs      AuditLog[]
}

/// One active password-reset code per user. The code is stored hashed.
model PasswordResetCode {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
}

/// Recent reset-code sends, keyed by email or IP, for rate limits.
model PasswordResetSend {
  id        String   @id @default(cuid())
  bucket    String
  createdAt DateTime @default(now())

  @@index([bucket, createdAt])
}

/// Login failures and registration attempts, keyed by email or IP.
/// `action` is "login" or "register". `bucket` is "email:…" or "ip:…".
model AuthRateEvent {
  id        String   @id @default(cuid())
  action    String
  bucket    String
  createdAt DateTime @default(now())

  @@index([action, bucket, createdAt])
}

model Product {
  id              String   @id @default(cuid())
  name            String
  description     String
  priceCents      Int      // RMB fen (分), display as ¥
  imageUrl        String?
  isSubscription  Boolean  @default(false)
  active          Boolean  @default(true)
  /// Null means stock is not tracked. Zero means it cannot be purchased.
  stock           Int?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  orderItems      OrderItem[]
}

model Order {
  id              String   @id @default(cuid())
  orderNo         String   @unique
  publicToken     String   @unique @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  status          String   @default("PENDING") // PENDING | PAYING | PAID | COMPLETED | REFUNDING | REFUNDED | CANCELLED | FAILED
  totalCents      Int
  paymentMethod   String?  // WECHAT | ALIPAY | MOCK
  paymentProvider String?
  paidAt          DateTime?
  isRenewal       Boolean  @default(false)
  parentOrderId   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  items           OrderItem[]
  tickets         Ticket[]
}

/// One row per provider event. Retries of the same event do not pay twice.
model PaymentNotice {
  id              String   @id @default(cuid())
  provider        String
  providerEventId String
  orderNo         String
  amountCents     Int
  outcome         String // APPLIED | DUPLICATE | REJECTED
  createdAt       DateTime @default(now())

  @@unique([provider, providerEventId])
  @@index([orderNo])
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  order            Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product @relation(fields: [productId], references: [id])
  productName      String
  unitPriceCents   Int
  quantity         Int     @default(1)
  isSubscription   Boolean @default(false)
}

model Ticket {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  subject   String
  status    String   @default("OPEN") // OPEN | REPLIED | CLOSED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  replies   TicketReply[]
}

model TicketReply {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  body      String
  isStaff   Boolean  @default(false)
  createdAt DateTime @default(now())
}

/// One pending email-change code per user. The code is stored hashed.
model EmailChangeCode {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  newEmail  String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
}

/// Admin mutations: who, what, when, and the before/after payload.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  actorEmail String
  action     String
  targetType String
  targetId   String
  note       String?
  beforeJson String?
  afterJson  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}

model SiteSetting {
  id           String   @id @default("default")
  siteName     String   @default("aisubscr")
  supportEmail String   @default("support@example.com")
  supportHours String   @default("08:00–23:00")
  footerText   String   @default("示例数字商品商城框架 · 仅供演示")
  updatedAt    DateTime @updatedAt
}

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String
  content     String
  published   Boolean  @default(true)
  authorName  String   @default("管理员")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
