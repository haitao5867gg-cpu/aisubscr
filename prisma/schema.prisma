generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  name           String?
  role           String   @default("USER") // USER | ADMIN
  disabled       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  sessionVersion Int      @default(0) // bumped to invalidate iron-session cookies
  /// AES-GCM payload of the active TOTP secret. Null until enrollment is confirmed.
  totpSecretEnc  String?
  /// AES-GCM payload of a secret that is not active until the admin confirms a code.
  totpPendingEnc String?
  totpEnabled    Boolean  @default(false)
  totpEnabledAt  DateTime?
  /// Last accepted RFC 6238 time step, so the same code cannot be reused in the window.
  totpLastStep   Int?
  orders         Order[]
  totpRecoveryCodes TotpRecoveryCode[]
  tickets        Ticket[]       @relation("TicketOwner")
  assignedTickets Ticket[]      @relation("TicketAssignee")
  ticketReplies  TicketReply[]
  passwordResetCode PasswordResetCode?
  emailChangeCode EmailChangeCode?
  auditLogs      AuditLog[]
  couponRedemptions CouponRedemption[]
  couponUsages   CouponUserUsage[]
}

/// One active password-reset code per user. The code is stored hashed.
/// One-time backup codes for an admin who enrolled in TOTP. Only the hash is stored.
model TotpRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetCode {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
}

/// Recent reset-code sends, keyed by email or IP, for rate limits.
model PasswordResetSend {
  id        String   @id @default(cuid())
  bucket    String
  createdAt DateTime @default(now())

  @@index([bucket, createdAt])
}

/// Login failures and registration attempts, keyed by email or IP.
/// `action` is "login" or "register". `bucket` is "email:…" or "ip:…".
model AuthRateEvent {
  id        String   @id @default(cuid())
  action    String
  bucket    String
  createdAt DateTime @default(now())

  @@index([action, bucket, createdAt])
}

model Product {
  id              String   @id @default(cuid())
  name            String
  description     String
  priceCents      Int      // RMB fen (分), display as ¥
  imageUrl        String?
  isSubscription  Boolean  @default(false)
  active          Boolean  @default(true)
  /// Null means stock is not tracked. Zero means it cannot be purchased.
  stock           Int?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  orderItems      OrderItem[]
}

model Order {
  id              String   @id @default(cuid())
  orderNo         String   @unique
  publicToken     String   @unique @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  status          String   @default("PENDING") // PENDING | PAYING | PAID | COMPLETED | REFUNDING | REFUNDED | CANCELLED | FAILED | EXPIRED
  subtotalCents   Int      @default(0)
  discountCents   Int      @default(0)
  totalCents      Int
  couponCode      String?
  /// Snapshot of Coupon.id. Not a foreign key so a retired code can be removed after its redemptions are gone.
  couponId        String?
  /// Unpaid orders past this instant are expired and their stock and coupon hold are released.
  expiresAt       DateTime?
  paymentMethod   String?  // WECHAT | ALIPAY | MOCK
  paymentProvider String?
  paidAt          DateTime?
  isRenewal       Boolean  @default(false)
  parentOrderId   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  items           OrderItem[]
  tickets         Ticket[]
  redemption      CouponRedemption?

  @@index([userId, createdAt])
  @@index([userId, status, createdAt])
  @@index([status, createdAt])
  @@index([status, expiresAt])
}

/// One row per provider event. Retries of the same event do not pay twice.
model PaymentNotice {
  id              String   @id @default(cuid())
  provider        String
  providerEventId String
  orderNo         String
  amountCents     Int
  outcome         String // APPLIED | DUPLICATE | REJECTED
  createdAt       DateTime @default(now())

  @@unique([provider, providerEventId])
  @@index([orderNo])
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  order            Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product @relation(fields: [productId], references: [id])
  productName      String
  unitPriceCents   Int
  quantity         Int     @default(1)
  isSubscription   Boolean @default(false)
}

model Ticket {
  id         String    @id @default(cuid())
  /// Optional. The order must belong to the same user when it is set.
  orderId    String?
  order      Order?    @relation(fields: [orderId], references: [id])
  userId     String
  user       User      @relation("TicketOwner", fields: [userId], references: [id])
  subject    String
  /// order | billing | account | technical | other
  category   String    @default("other")
  /// OPEN | WAITING_CUSTOMER | RESOLVED | CLOSED
  status     String    @default("OPEN")
  assigneeId String?
  assignee   User?     @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  replies    TicketReply[]

  @@index([userId, updatedAt])
  @@index([status, updatedAt])
  @@index([assigneeId, status])
}

model TicketReply {
  id          String             @id @default(cuid())
  ticketId    String
  ticket      Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId      String
  user        User               @relation(fields: [userId], references: [id])
  body        String
  isStaff     Boolean            @default(false)
  /// Staff-only. Hidden from the customer, the public order page, and reply email.
  internal    Boolean            @default(false)
  createdAt   DateTime           @default(now())
  attachments TicketAttachment[]
}

model TicketAttachment {
  id        String      @id @default(cuid())
  replyId   String
  reply     TicketReply @relation(fields: [replyId], references: [id], onDelete: Cascade)
  url       String
  createdAt DateTime    @default(now())

  @@index([replyId])
}

/// One pending email-change code per user. The code is stored hashed.
model EmailChangeCode {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  newEmail  String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
}

/// Admin mutations: who, what, when, and the before/after payload.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  actorEmail String
  action     String
  targetType String
  targetId   String
  note       String?
  beforeJson String?
  afterJson  String?
  createdAt  DateTime @default(now())

  /// Hot path: the audit page lists newest first.
  @@index([createdAt])
  @@index([targetType, targetId])
}

model SiteSetting {
  id                   String   @id @default("default")
  siteName             String   @default("aisubscr")
  supportEmail         String   @default("support@example.com")
  supportHours         String   @default("08:00–23:00")
  footerText           String   @default("示例数字商品商城框架 · 仅供演示")
  wechatId             String   @default("")
  qq                   String   @default("")
  /// Empty means the contact page uses supportEmail.
  contactEmail         String   @default("")
  /// Public URL for the customer-service QR. Legacy qrImageData is used when this is empty.
  qrImageUrl           String?
  /// When true, an admin who has not enrolled in TOTP can only open the enrollment page.
  adminTotpRequired    Boolean  @default(false)
  qrImageMime          String?
  /// Base64 image bytes. Never returned from the public settings JSON.
  qrImageData          String?
  announcementText     String   @default("")
  announcementEnabled  Boolean  @default(false)
  /// Minutes before an unpaid order expires. Ignored when ORDER_EXPIRE_MINUTES is set.
  orderExpireMinutes   Int      @default(30)
  /// Empty means paid-order and new-ticket notices are not sent.
  adminNotifyEmail     String   @default("")
  notifyPaidOrders     Boolean  @default(true)
  notifyNewTickets     Boolean  @default(true)
  updatedAt            DateTime @updatedAt
}

/// First-party page view. The visitor id is a daily HMAC. Raw IPs are not stored.
model PageView {
  id          String   @id @default(cuid())
  path        String
  /// Referrer hostname only. Empty when the visit is direct or same-site.
  referrer    String   @default("")
  /// mobile | tablet | desktop
  device      String
  visitorHash String
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([visitorHash, path, createdAt])
}

/// Checkout and paid steps. Product views and cart views are counted from PageView.
model AnalyticsEvent {
  id          String   @id @default(cuid())
  /// checkout | paid
  kind        String
  visitorHash String
  orderId     String   @default("")
  createdAt   DateTime @default(now())

  @@index([kind, createdAt])
  @@index([orderId])
  @@index([createdAt])
}

/// Promo code. Usage is reserved in the same transaction that creates the order.
model Coupon {
  id             String   @id @default(cuid())
  /// Unique index used when checkout looks up a code.
  code           String   @unique
  kind           String   // PERCENT | FIXED
  percentOff     Int?
  amountCents    Int?
  minOrderCents  Int      @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  maxUses        Int?
  maxUsesPerUser Int?
  usedCount      Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  redemptions    CouponRedemption[]
  userUsages     CouponUserUsage[]
}

/// Per-user counter updated with a conditional increment so concurrent checkouts cannot pass the cap.
model CouponUserUsage {
  couponId  String
  userId    String
  usedCount Int      @default(0)
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([couponId, userId])
}

model CouponRedemption {
  id            String    @id @default(cuid())
  couponId      String
  coupon        Coupon    @relation(fields: [couponId], references: [id], onDelete: Restrict)
  orderId       String    @unique
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  discountCents Int
  releasedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([couponId, userId])
}

model FaqEntry {
  id        String   @id @default(cuid())
  question  String
  answer    String
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String
  content     String
  published   Boolean  @default(true)
  authorName  String   @default("管理员")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
